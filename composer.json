{
  "name": "formburden/edtb-continuation",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11",
    "squizlabs/php_codesniffer": "^3.9"
  },
  "autoload": {
    "psr-4": {
      "EDTB\\": "src/"
    }
  },
  "scripts": {
    "migrate": "php bin/migrate",
    "lint": "php -l $(git ls-files '*.php')",
    "cs": "phpcs --standard=PSR12 src public",
    "stan": "phpstan analyse src --level=6"
  }
}
