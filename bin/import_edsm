#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

export DATA_DIR="${DATA_DIR:-${ROOT_DIR}/data}"

# Expect DB_* vars in environment; matches src/Config.php and .env if you use one:
#   DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASS

python3 "${ROOT_DIR}/scripts/import_edsm.py" "$@"
